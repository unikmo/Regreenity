mpaignType]||c.campaignType} · {c.status} · {c.participants||0} participants · {c.eligible||0} eligible</span>{c.noPurchaseRequired&&<small>No purchase required</small>}</div><div className="sim-row-actions">{c.campaignType!=='pulse_completion'&&c.status!=='live'&&c.status!=='drawn'&&<button onClick={()=>act(()=>clientSetParticipationStatus(c.id,'live'))}>Go live</button>}{c.campaignType!=='pulse_completion'&&c.status==='live'&&<button onClick={()=>act(()=>clientSetParticipationStatus(c.id,'closed'))}>Close</button>}{c.campaignType!=='pulse_completion'&&c.winnerCount>0&&['live','closed'].includes(c.status)&&(c.eligible||0)>0&&<button className="sim-primary compact" onClick={()=>act(()=>clientDrawParticipation(c.id))}>Draw {c.winnerCount}</button>}</div>{(c.winners||[]).length>0&&<div className="sim-live-winners">{(c.winners||[]).map(w=><span key={`${c.id}-${w.rank}`}>#{w.rank} {w.entryCode||w.passenger_account_id} · {w.prize}</span>)}</div>}</div>)}</div><div className="sim-live-create"><small>NEW LIVE MOMENT</small><div className="sim-form-grid"><label>Type<select value={type} onChange={e=>setType(e.target.value)}><option value="raffle">Live draw</option><option value="poll">Audience poll</option><option value="trivia">Trivia + draw</option><option value="check_in">Digital check-in draw</option><option value="activity">Activity participation</option></select></label><label>Title<input value={title} onChange={e=>setTitle(e.target.value)} placeholder="Pool Deck Flash Draw"/></label><label className="wide">Passenger message<input value={message} onChange={e=>setMessage(e.target.value)} placeholder="Join live from your phone — no paper ticket."/></label>{['poll','trivia'].includes(type)&&<><label className="wide">Question<input value={prompt} onChange={e=>setPrompt(e.target.value)}/></label><label className="wide">Options, comma separated<input value={options} onChange={e=>setOptions(e.target.value)} placeholder="Option A, Option B, Option C"/></label></>}{type!=='poll'&&<><label>Winners<input type="number" min="1" max="20" value={winners} onChange={e=>setWinners(Math.max(1,Math.min(20,Number(e.target.value))))}/></label><label>Prize<input value={prize} onChange={e=>setPrize(e.target.value)}/></label></>}</div><button className="sim-primary" disabled={!title||!message||(['poll','trivia'].includes(type)&&options.split(',').filter(Boolean).length<2)} onClick={create}>Create & go live</button></div></div>
}

function IntegrationPanel() {
  const [items,setItems]=useState<IntegrationConnector[]>([])
  useEffect(()=>{clientLoadIntegrations().then(setItems).catch(()=>{})},[])
  if(!items.length)return null
  return <div className="sim-card"><small>PILOT INTEGRATION READINESS</small><h2>Adapter boundary</h2><div className="sim-integration-list">{items.map(i=><div key={i.type}><b>{i.type.split('_').join(' ')}</b><span className={`integration-status ${i.status}`}>{i.status}</span><small>{i.detail}</small></div>)}</div></div>
}

function StaffView({ account, directory, refresh }: { account:PilotAccount; directory:RemoteDirectory; refresh:()=>void }) {
  const [overview,setOverview]=useState<StaffOverview|null>(null)
  const [error,setError]=useState('')
  const [title,setTitle]=useState('')
  const [message,setMessage]=useState('')
  const [category,setCategory]=useState('Onboard experience')
  const [interests,setInterests]=useState('Food experiences')
  const load=async()=>{try{if(account.role==='activities')setOverview({activities:directory.activities||[]});else setOverview(await clientLoadStaffOverview());setError('')}catch(e){setError(e instanceof Error?e.message:'Unable to load staff dashboard.')}}
  useEffect(()=>{load();const timer=window.setInterval(load,4000);return()=>window.clearInterval(timer)},[account.id])
  const act=async(fn:()=>Promise<unknown>)=>{try{await fn();await load();refresh()}catch(e){setError(e instanceof Error?e.message:'Action failed.')}}
  const roleTitle=account.role==='guest_services'?'Guest Services / Hotel Ops':account.role==='marketing'?'Marketing':account.role==='sales'?'Sales & Revenue':account.role==='activities'?'Entertainment & Activities':'Crew Leadership'
  const pulse=overview?.pulse
  return <div className="sim-role-page staff-role-page"><div className="sim-role-head"><small>{roleTitle.toUpperCase()} · PILOT ACCESS</small><h1>{directory.sailing.title}</h1><p>{directory.sailing.shipName} · {directory.sailing.number}</p></div>{error&&<div className="sim-error">{error}</div>}{pulse&&<><div className="sim-metric-grid"><div><b>{pulse.completed}/{pulse.totalPassengers}</b><span>Final-night pulse completed</span></div><div><b>{Math.round(pulse.completionRate*100)}%</b><span>Participation</span></div><div><b>{pulse.departments.length}</b><span>Departments rated</span></div></div><div className="sim-card"><small>DEPARTMENT PULSE</small><div className="sim-dept-summary">{pulse.departments.map(d=><div key={d.id}><b>{d.average.toFixed(1)}</b><span>{d.name}</span><div><i style={{width:`${d.average/5*100}%`}}/></div></div>)}</div></div></>}
    {account.role==='guest_services'&&<div className="sim-card"><small>PRIVATE SERVICE RECOVERY</small><h2>Operational lifecycle</h2><p>Submitted → acknowledged → assigned → resolved → passenger post-recovery 1–5 pulse.</p>{(overview?.serviceIssues||[]).length===0?<p>No issues in the pilot.</p>:(overview?.serviceIssues||[]).map(i=><div className="sim-staff-row" key={i.id}><div><b>{i.category}</b><span>{i.department_id||'General'} · {i.passenger_account_id} · {i.status}</span></div><div className="sim-row-actions">{i.status==='submitted'&&<button onClick={()=>act(()=>clientUpdateServiceIssueStatus(i.id,'acknowledged'))}>Acknowledge</button>}{['submitted','acknowledged'].includes(i.status)&&<button onClick={()=>act(()=>clientUpdateServiceIssueStatus(i.id,'assigned',{assigneeId:account.id}))}>Assign to me</button>}{!['resolved','closed'].includes(i.status)&&<button onClick={()=>act(()=>clientUpdateServiceIssueStatus(i.id,'resolved',{resolutionCode:'resolved_onboard'}))}>Resolve</button>}</div></div>)}</div>}
    {(account.role==='marketing'||account.role==='sales')&&<><div className="sim-card"><small>ONBOARD PROMOTIONS</small><h2>{account.role==='marketing'?'Create, target and activate promotions.':'Manage offers and watch conversion.'}</h2><div className="sim-promo-stack">{(overview?.promotions||[]).map(p=><div className="sim-promo-item" key={p.id}><div><b>{p.title}</b><span>{p.category} · {p.status} · {p.clicks||0} clicks · {p.bookings||0} bookings</span><small>{p.message}</small></div><div className="sim-row-actions">{p.status!=='live'&&<button onClick={()=>act(()=>clientSetPromotionStatus(p.id,'live'))}>Go live</button>}{p.status==='live'&&<button onClick={()=>act(()=>clientSetPromotionStatus(p.id,'paused'))}>Pause</button>}</div></div>)}</div></div><div className="sim-card"><small>NEW PROMOTION</small><div className="sim-form-grid"><label>Title<input value={title} onChange={e=>setTitle(e.target.value)}/></label><label>Category<input value={category} onChange={e=>setCategory(e.target.value)}/></label><label className="wide">Message<input value={message} onChange={e=>setMessage(e.target.value)}/></label><label className="wide">Target interests<input value={interests} onChange={e=>setInterests(e.target.value)} placeholder="Food experiences, Fitness"/></label></div><button className="sim-primary" disabled={!title||!message} onClick={()=>act(async()=>{await clientCreatePromotion({title,category,message,targetInterests:interests.split(',').map(x=>x.trim()).filter(Boolean),status:'live'});setTitle('');setMe