ton>}
    {tab==='home'&&<><div className="sim-hero-card"><small>DAY {sailing.day} OF {sailing.days}</small><h2>Good evening, {account.firstName}.</h2><p>Your interests, recognitions, live participation and positive connections stay scoped to this sailing.</p><div className="sim-interest-chips">{(account.interests||[]).map(i=><span key={i}>{i}</span>)}</div></div><RecoveryFollowUp/>{incoming.length>0&&<div className="sim-card"><small>NEW POSITIVE MOMENT</small><h3>You received {incoming.length} affirmation{incoming.length>1?'s':''}.</h3>{incoming.map(a=>{const sender=accounts.find(x=>x.id===a.fromId);return <div className="sim-incoming" key={a.id}><div><b>{a.label}</b><span>From {sender?.firstName}</span></div><button onClick={()=>act(()=>clientRespondAffirmation(a.id,account.id,'acknowledged'))}>Acknowledge</button><button className="ghost" onClick={()=>act(()=>clientRespondAffirmation(a.id,account.id,'ignored'))}>Ignore</button></div>})}</div>}{(directory.promotions||[]).length>0&&<div className="sim-card"><small>FOR YOU ON THIS SAILING</small><h3>Relevant onboard opportunities</h3><div className="sim-promo-stack">{(directory.promotions||[]).map(p=><div className="sim-promo-item" key={p.id}><div><b>{p.title}</b><span>{p.message}</span>{p.incentive&&<small>{p.incentive}</small>}</div><button onClick={()=>act(async()=>{await clientTrackPromotion(p.id,'click');if(p.bookingRoute)window.dispatchEvent(new CustomEvent('cruise-connection:booking',{detail:{route:p.bookingRoute,promotionId:p.id}}))})}>View / book</button></div>)}</div></div>}<div className="sim-card-grid"><button onClick={()=>setTab('live')}><b>Live participation</b><span>Paperless draws, polls & check-ins</span></button><button onClick={()=>setTab('help')}><b>Get help now</b><span>Private service recovery</span></button><button onClick={()=>setTab('connect')}><b>People & interests</b><span>{nearby.length} opted-in passengers nearby</span></button><button onClick={()=>setTab('crew')}><b>Recognize crew</b><span>Say thank you in seconds</span></button><button onClick={()=>setTab('pulse')}><b>Experience Pulse</b><span>{state.finalPulseActive?'Final-night pulse is live':'Available on final night'}</span></button></div></>}
    {tab==='live'&&<PassengerLiveParticipation/>}
    {tab==='help'&&<PassengerRecovery directory={directory}/>} 
    {tab==='connect'&&<div className="sim-card"><small>SAFE PASSENGER CONNECTION</small><h2>Nearby, shared activity or shared interests.</h2><p>Only opted-in adult passengers are shown. No exact location, cabin, surname or open chat.</p><div className="sim-people-list">{nearby.map(p=><button key={p.id} className={selectedPassenger===p.id?'active':''} onClick={()=>setSelectedPassenger(p.id)}><span>{p.firstName.slice(0,2).toUpperCase()}</span><div><b>{p.firstName}</b><small>{(p.interests||[]).slice(0,2).join(' · ')}</small></div></button>)}</div><div className="sim-action-panel"><b>Send one predefined affirmation</b><div className="sim-chip-actions">{affirmations.map(a=><button key={a} onClick={()=>act(()=>clientSendAffirmation(account.id,selectedPassenger,a))}>{a}</button>)}</div>{acknowledged&&<><b className="sim-next-label">Recipient responded — public meeting proposals unlocked</b><div className="sim-chip-actions public">{publicPlaces.map(p=><button key={p} onClick={()=>act(()=>clientProposeMeeting(account.id,selectedPassenger,p))}>{p}</button>)}</div></>}</div></div>}
    {tab==='crew'&&<div className="sim-card"><small>CREW RECOGNITION</small><h2>Recognize service while it is fresh.</h2><p>One recognition per guest → crew member → sailing day. Choose one or two reasons. No public ranking.</p><div className="sim-crew-list">{crew.map(c=><button key={c.id} className={selectedCrew===c.id?'active':''} onClick={()=>setSelectedCrew(c.id)}><span>{c.firstName.slice(0,2).toUpperCase()}</span><div><b>{c.firstName} {c.lastName}</b><small>{c.department} · badge {c.badgeId}</small></div></button>)}</div><div className="sim-chip-actions reasons">{recognitionReasons.map(r=><button key={r} className={selectedReasons.includes(r)?'active':''} onClick={()=>toggleReason(r)}>{r}</button>)}</div><button className="sim-primary" onClick={()=>act(()=>clientRecognizeCrew(account.id,selectedCrew,selectedReasons))}>Send recognition</button></div>}
    {tab==='pulse'&&<FinalPulse account={account} state={state} departments={departments} refresh={refresh}/>} {notice&&<div className="sim-toast" onClick={()=>setNotice('')}>{notice}</div>}
  </div></div>
}

function CrewView({ account, state, directory }: { account:PilotAccount; state:PilotState; directory:RemoteDirectory }) {
  const crew=directory.crew.find(c=>c.id===account.crewId)!
  const live=state.crewRecognitions.filter(r=>r.crewId===crew.id)
  return <div className="sim-role-page"><div className="sim-role-head"><small>CREW RECOGNITION · {directory.sailing.number} · {directory.sailing.startDate} → {directory.sailing.endDate}</small><h1>{crew.firstName} {crew.lastName}</h1><p>{crew.department} · badge {crew.badgeId}</p></div><div className="sim-metric-grid"><div><b>{crew.recognitions+live.length}</b><span>Total recognitions</span></div><div><b>{crew.uniqueGuests+new Set(live.map(r=>r.passengerId)).size}</b><span>Unique guests</span></div><div><b>6/7</b><span>Sailing days recognized</span></div></div><div className="sim-card"><h3>Latest recognition</h3>{live.length?live.map(r=><div className="sim-log-line" key={r.id}><b>{r.reasons.join(' · ')}</b><span>{fmt(r.createdAt)}</span></div>):<p>No new simulation recognition yet.</p>}</div></div>
}

function StaffParticipationPanel({ account }: { account:PilotAccount }) {
  const [campaigns,setCampaigns]=useState<ParticipationCampaign[]>([])
  const [error,setError]=useState('')
  const [title,setTitle]=useState('')
  const [message,setMessage]=useState('')
  const [type,setType]=useState('raffle')
  const [prompt,setPrompt]=useState('')
  const [options,setOptions]=useState('')
  const [prize,setPrize]=useState('$50 onboard credit')
  const [winners,setWinners]=useState(1)
  const load=async()=>{try{setCampaigns(await clientLoadParticipationCampaigns());setError('')}catch(e){setError(e instanceof Error?e.message:'Unable to load participation campaigns.')}}
  useEffect(()=>{load();const timer=window.setInterval(load,4000);return()=>window.clearInterval(timer)},[account.id])
  const act=async(fn:()=>Promise<unknown>)=>{try{await fn();await load()}catch(e){setError(e instanceof Error?e.message:'Action failed.')}}
  const create=()=>act(async()=>{const opts=options.split(',').map(x=>x.trim()).filter(Boolean);await clientCreateParticipationCampaign({title,message,campaignType:type,prompt:prompt||undefined,options:opts,correctOption:type==='trivia'?opts[0]:undefined,showLiveResults:type==='poll',winnerCount:type==='poll'?0:winners,adultPrize:type==='poll'?undefined:prize,alternatePrize:type==='poll'?undefined:prize,noPurchaseRequired:true,status:'live'});setTitle('');setMessage('');setPrompt('');setOptions('')})
  return <div className="sim-card live-ops-card"><div className="sim-card-head"><div><small>LIVE PARTICIPATION · PAPERLESS</small><h2>Replace paper raffle slips with verified live participation.</h2></div><span>Push · app tile · QR/deep link</span></div><p>Run draws, polls, trivia and check-ins throughout the sailing. The final-night Experience Pulse draw remains a separate completion-based use case.</p>{error&&<div className="sim-error">{error}</div>}<div className="sim-live-admin-list">{campaigns.map(c=><div className="sim-live-admin-row" key={c.id}><div><b>{c.title}</b><span>{campaignTypeLabel[c.ca