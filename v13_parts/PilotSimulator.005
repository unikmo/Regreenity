ssage('')})}>Create & launch promotion</button></div>{account.role==='sales'&&overview?.commerce&&<div className="sim-metric-grid"><div><b>{overview.commerce.events}</b><span>Commerce events</span></div><div><b>${overview.commerce.attributableRevenue.toFixed(0)}</b><span>Attributed revenue</span></div><div><b>{(overview.activities||[]).length}</b><span>Active inventory items</span></div></div>}</>}
    {['marketing','sales','activities'].includes(account.role)&&<StaffParticipationPanel account={account}/>} {account.role==='activities'&&<div className="sim-card"><small>ACTIVE INVENTORY</small><h2>Participation around real onboard programming</h2>{(overview?.activities||directory.activities||[]).map((a:any)=><div className="sim-staff-row" key={a.id}><div><b>{a.title}</b><span>{a.category}</span></div><span>{a.remaining_capacity??'—'} spaces left</span></div>)}</div>}
    {account.role==='crew_lead'&&<div className="sim-card"><small>CREW RECOGNITION</small><h2>Recognition across the sailing</h2>{(overview?.crew||[]).sort((a,b)=>b.totalRecognitions-a.totalRecognitions).map(c=><div className="sim-staff-row" key={c.id}><div><b>{c.firstName} {c.lastName}</b><span>{c.department}</span></div><div><b>{c.totalRecognitions}</b><span> recognitions</span></div></div>)}</div>}
  </div>
}

function DirectorView({ account, state, directory, refresh, admin=false }: { account:PilotAccount; state:PilotState; directory:RemoteDirectory; refresh:()=>void; admin?:boolean }) {
  const { sailing, accounts, departments } = directory
  const [winnerCount,setWinnerCount]=useState<1|3>(state.prize.winnerCount)
  const [adultPrize,setAdultPrize]=useState(state.prize.adultPrize)
  const completed=Object.keys(state.pulseResponses).length
  const avgByDept=departments.map(d=>{const vals=Object.values(state.pulseResponses).map(r=>r[d.id]).filter(Boolean);return { ...d, avg:vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:0 }})
  const act=async(fn:()=>Promise<unknown>)=>{await fn();refresh()}
  return <div className="sim-role-page director-page"><div className="sim-role-head"><small>{admin?'CRUISE-LINE ADMIN':'CRUISE DIRECTOR'} · PILOT CONTROL</small><h1>{sailing.title}</h1><p>{sailing.shipName} · {sailing.number} · Final night</p></div><div className="sim-director-grid"><div className="sim-card director-launch"><small>LAST-NIGHT MOMENT</small><h2>“Please take out your phones.”</h2><p>In under two minutes, rate each department 1–5. Every completed response enters tonight’s configured draw.</p><button className="sim-primary" onClick={()=>act(()=>clientLaunchPulse(account.id))}>{state.finalPulseActive?'Re-send final-night push':'Launch final-night pulse'}</button><span className="sim-launch-status">{state.finalPulseActive?`Live · ${fmt(state.finalPulseLaunchedAt)}`:'Not yet launched'}</span></div><div className="sim-card"><small>FINAL-NIGHT PARTICIPATION</small><div className="sim-big-number">{completed}</div><p>completed department pulses</p><div className="sim-mini-bar"><i style={{width:`${Math.min(100,completed/6*100)}%`}}/></div></div></div><div className="sim-card"><div className="sim-card-head"><div><small>DEPARTMENT SATISFACTION</small><h2>One 1–5 score per department. No text.</h2></div><span>Private operational layer</span></div><div className="sim-dept-summary">{avgByDept.map(d=><div key={d.id}><b>{d.avg.toFixed(1)}</b><span>{d.name}</span><div><i style={{width:`${d.avg/5*100}%`}}/></div></div>)}</div></div><div className="sim-card prize-admin"><div><small>FINAL-NIGHT COMPLETION INCENTIVE</small><h2>Experience Pulse draw</h2><p>Only passengers who complete all required department scores are eligible. This remains separate from the reusable live-participation engine below.</p></div><div className="sim-prize-config"><label>Winners<select value={winnerCount} onChange={(e: ChangeEvent<HTMLSelectElement>)=>setWinnerCount(Number(e.target.value) as 1|3)}><option value="1">1 winner</option><option value="3">3 winners</option></select></label><label>Adult prize<input value={adultPrize} onChange={(e: ChangeEvent<HTMLInputElement>)=>setAdultPrize(e.target.value)}/></label><button onClick={()=>act(()=>clientUpdatePrize(account.id,{winnerCount,adultPrize,alternatePrize:'Premium non-alcoholic celebration + $150 future-cruise voucher'}))}>Save prize</button><button className="sim-primary" disabled={!state.finalPulseActive||completed===0} onClick={()=>act(()=>clientDrawWinners(account.id))}>Draw {winnerCount} winner{winnerCount>1?'s':''}</button></div></div>{state.winners.length>0&&<div className="sim-card winner-card"><small>FINAL-NIGHT DRAW RESULT</small><h2>Winners</h2><div className="sim-winners">{state.winners.map((w,i)=>{const p=accounts.find(a=>a.id===w.passengerId)!;return <div key={w.passengerId}><span>#{i+1}</span><b>{p?.firstName} {p?.lastName}</b><small>{w.prize}</small></div>})}</div></div>}<StaffParticipationPanel account={account}/><IntegrationPanel/>{admin&&<div className="sim-card"><small>SIMULATION ADMIN</small><h2>Runtime controls</h2><div className="sim-adapter-grid"><span><b>Auth</b> Simulation signed session</span><span><b>Persistence</b> {clientMode()}</span><span><b>Offline</b> App shell + action queue</span><span><b>Participation</b> Shared database + server-side draw</span></div><button className="sim-danger" onClick={async()=>{await clientReset();location.reload()}}>Reset pilot simulation</button></div>}<div className="sim-card"><small>AUDIT LOG</small><h3>Latest runtime events</h3>{state.audit.slice(0,8).map((a,i)=><div key={`${a.at}-${i}`} className="sim-log-line"><div><b>{a.type.split('_').join(' ')}</b><small>{a.actorId}</small></div><span>{fmt(a.at)}</span></div>)}</div></div>
}

export default function PilotSimulator() {
  const [revision,setRevision]=useState(0)
  const [state,setState]=useState<PilotState>(()=>loadPilotState())
  const [directory,setDirectory]=useState<RemoteDirectory>({ sailing: pilotSailing, accounts: pilotAccounts, crew: crewMembers, departments: localDepartments })
  const refresh=()=>setRevision(x=>x+1)
  const session=clientSession(), account=clientAccount()
  useEffect(()=>{let live=true;if(!session)return()=>{live=false};Promise.all([clientLoadState(),clientLoadDirectory()]).then(([nextState,nextDirectory])=>{if(live){setState(nextState);setDirectory(nextDirectory)}}).catch(()=>{});return()=>{live=false}},[revision,session?.token])
  useEffect(()=>{const h=()=>refresh();window.addEventListener('cruise-connection-pilot-state',h);return()=>window.removeEventListener('cruise-connection-pilot-state',h)},[])
  if(!session||!account)return <main className="pilot-simulator-page"><Login onLogin={refresh}/></main>
  const logout=()=>{clientLogout();refresh()}
  return <main className="pilot-simulator-page"><Shell account={account} sailing={directory.sailing} onLogout={logout}>{account.role==='passenger'&&<PassengerView account={account} state={state} directory={directory} refresh={refresh}/>} {account.role==='crew'&&<CrewView account={account} state={state} directory={directory}/>} {account.role==='director'&&<DirectorView account={account} state={state} directory={directory} refresh={refresh}/>} {['guest_services','marketing','sales','crew_lead','activities'].includes(account.role)&&<StaffView account={account} directory={directory} refresh={refresh}/>} {account.role==='admin'&&<DirectorView account={account} state={state} directory={directory} refresh={refresh} admin/>}</Shell></main>
}
